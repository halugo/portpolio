# 이 파일을 복사해서 .env.local로 만들고 실제 값을 채워넣으세요.
# .env.local은 절대 Git에 커밋하지 마세요 (.gitignore에 이미 포함되어 있습니다).
# 실제 배포 시에는 이 값들을 Vercel 대시보드 → Project → Settings → Environment Variables 에 등록합니다.

# ---- 관리자 로그인 (고정 계정) ----
ADMIN_USERNAME=admin
# scripts/hash-password.js 로 생성한 해시값을 넣으세요. (평문 비밀번호를 여기에 적지 마세요)
ADMIN_PASSWORD_HASH=

# ---- 세션(JWT) 서명 키 ----
# 아무 규칙 없는 랜덤 문자열 32자 이상 권장. 아래 명령으로 생성 가능:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role 키는 절대 프론트엔드 코드에 노출하지 마세요. 서버리스 함수에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=
